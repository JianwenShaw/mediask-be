          "paidAt": { "type": "string", "format": "date-time", "description": "支付时间" },
          "visitedAt": { "type": "string", "format": "date-time", "description": "就诊时间" },
          "createdAt": { "type": "string", "format": "date-time", "description": "创建时间" }
        }
      },
      "AppointmentResultResponse": {
        "type": "object",
        "properties": {
          "appointmentId": { "type": "integer", "format": "int64", "description": "预约ID" },
          "apptNo": { "type": "string", "description": "预约单号" },
          "doctorId": { "type": "integer", "format": "int64", "description": "医生ID" },
          "doctorName": { "type": "string", "description": "医生姓名" },
          "departmentName": { "type": "string", "description": "科室名称" },
          "apptDate": { "type": "string", "format": "date", "description": "就诊日期" },
          "timePeriodDesc": { "type": "string", "description": "时段描述" },
          "apptTime": { "type": "string", "format": "time", "description": "具体时间" },
          "status": { "type": "string", "description": "状态描述" },
          "apptFee": { "type": "number", "format": "decimal", "description": "挂号费" },
          "payDeadline": { "type": "string", "format": "date-time", "description": "支付截止时间" }
        }
      },
      "AvailableSlotResponse": {
        "type": "object",
        "properties": {
          "slotId": { "type": "integer", "format": "int64", "description": "时段ID" },
          "scheduleId": { "type": "integer", "format": "int64", "description": "排班ID" },
          "time": { "type": "string", "format": "time", "description": "时段开始时间" },
          "available": { "type": "boolean", "description": "是否可用" }
        }
      },
      "ScheduleResponse": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "format": "int64", "description": "排班ID" },
          "doctorId": { "type": "integer", "format": "int64", "description": "医生ID" },
          "doctorName": { "type": "string", "description": "医生姓名" },
          "scheduleDate": { "type": "string", "format": "date", "description": "排班日期" },
          "timePeriodDesc": { "type": "string", "description": "时段描述" },
          "totalSlots": { "type": "integer", "format": "int32", "description": "总号源数" },
          "availableSlots": { "type": "integer", "format": "int32", "description": "剩余号源数" },
          "statusCode": { "type": "integer", "format": "int32", "description": "状态码：0停诊 1开放 2约满 3过期" },
          "statusDesc": { "type": "string", "description": "状态描述" },
          "slotDurationMinutes": { "type": "integer", "format": "int32", "description": "号源时长（分钟）" }
        }
      },
      "CancelAppointmentRequest": {
        "type": "object",
        "required": ["appointmentId"],
        "properties": {
          "appointmentId": { "type": "integer", "format": "int64", "description": "预约ID" },
          "reason": { "type": "string", "description": "取消原因" },
          "operatorId": { "type": "integer", "format": "int64", "description": "操作人ID（管理员取消时使用）" },
          "operatorType": { "type": "integer", "format": "int32", "description": "操作人类型：1=患者 2=管理员" }
        },
        "example": { "appointmentId": 1, "reason": "时间冲突", "operatorId": 100, "operatorType": 2 }
      }
    }
  },
  "security": [{ "bearerAuth": [] }]
